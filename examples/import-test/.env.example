# Copy this file to .env in the same folder and fill in the values from your own trial accounts.
# .env is ignored by git. Leave a source empty to skip it.

# Zendesk Support trial: Admin Center > Apps and integrations > Zendesk API > add an API token.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=

# Intercom trial: Developer Hub > New app > Authentication > access token.
INTERCOM_TOKEN=

# Shopify development store (free with a Partner account): Settings > Apps > Develop apps > create an app,
# give it the read_legal_policies Admin API scope, install it, and copy the Admin API access token.
SHOPIFY_SHOP=
SHOPIFY_TOKEN=
