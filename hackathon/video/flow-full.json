[
  { "go": "/signup" },
  { "mark": "signup", "caption": "Brightdesk AI sells a customer-support agent. A new client, Linden & Co., is signing", "speed": 1 },
  { "wait": 1.5 },
  { "fill": "input[name=email]", "value": "__EMAIL__" },
  { "fill": "input[name=company]", "value": "Brightdesk AI" },
  { "check": "input[name=kind][value=vendor]" },
  { "wait": 0.8 },
  { "click": "Create free account" },
  { "click": "I saved it, continue" },

  { "mark": "client", "caption": "Every client gets its own workspace. Open Linden & Co., an online store", "speed": 1 },
  { "wait": 1.5 },
  { "click": "Open a sample client" },

  { "mark": "rollout", "caption": "One click: Grapim drafts every step from the client's own material, then runs the policy check", "speed": 1 },
  { "wait": 2 },
  { "click": "Run the rollout" },
  { "wait": 3 },
  { "mark": "drafting", "caption": "Mapping, integration, the connector to the client's order system and the test set (sped up)", "speed": 10 },
  { "until": "Run the rollout again", "max": 900 },
  { "mark": "steps", "caption": "Each step left a draft for a person to review", "speed": 1 },
  { "scrollTo": "Run the whole rollout", "hold": 4 },

  { "mark": "connector", "caption": "The connector: one tool per endpoint in Linden's API docs; the ones that act are marked", "speed": 1 },
  { "click": "Review", "selector": "a" },
  { "wait": 1.5 },
  { "scrollTo": "Client-system connector", "selector": "h3", "hold": 4 },
  { "click": "Approve and apply", "selector": "form[action*='-connector-'] button" },
  { "wait": 2 },
  { "mark": "testset", "caption": "Approve the test set built from Linden's past tickets", "speed": 1 },
  { "click": "Approve and apply", "selector": "form[action*='-cases-'] button" },
  { "wait": 2 },
  { "go": "/__ROLLOUT__" },
  { "mark": "code", "caption": "Approved: Grapim generates the code, and every action asks the guard before it runs", "speed": 1 },
  { "scrollTo": "Client-system connector", "selector": "h2", "hold": 6 },

  { "go": "/__SCAN__" },
  { "mark": "results", "caption": "The policy check: each tile is one rule from Linden's policy; red means the agent broke it", "speed": 1 },
  { "wait": 3 },
  { "scrollTo": "Broken rules", "hold": 3 },
  { "scrollBy": 300, "hold": 3 },
  { "scrollTo": "Fix it", "block": "center", "hold": 1.5 },
  { "mark": "fix", "caption": "The agent drafts one fix to the instructions; a person approves it", "speed": 2 },
  { "click": "Draft a fix" },
  { "until": "Proposed fix", "max": 180, "hold": 1 },
  { "scrollTo": "Proposed fix", "block": "start", "hold": 3 },
  { "click": "Approve, apply and re-check" },
  { "mark": "recheck", "caption": "The same messages run again on the fixed agent (sped up)", "speed": 5 },
  { "until": "After the fix", "after": "Judging", "max": 500, "hold": 2 },
  { "mark": "after", "caption": "Before and after, on the same messages", "speed": 1 },
  { "wait": 4 },

  { "go": "/__ROLLOUT__" },
  { "mark": "signoff", "caption": "Send Linden a sign-off link: no account needed", "speed": 1 },
  { "click": "Create a sign-off link" },
  { "wait": 1.5 },
  { "readInput": "/signoff/", "as": "link" },
  { "goVar": "link" },
  { "mark": "client-view", "caption": "Linden's head of support accepts, and lets Brightdesk reuse what it learned, de-identified", "speed": 1 },
  { "wait": 2 },
  { "fill": "input[name=name]", "value": "Dana Lee" },
  { "check": "input[name=reuse]" },
  { "wait": 1.5 },
  { "click": "Record my decision" },
  { "wait": 3 },

  { "go": "/__ROLLOUT__" },
  { "mark": "playbook", "caption": "Linden's test messages and integration shape are now in Brightdesk's playbook", "speed": 1 },
  { "scrollTo": "Playbook", "selector": "h2", "hold": 4 },
  { "mark": "monitoring", "caption": "After launch: monitoring re-runs the tests on a schedule and whenever the model or system changes", "speed": 1 },
  { "scrollTo": "Monitoring", "selector": "h2", "block": "center", "hold": 2 },
  { "select": "select[name=enabled]", "value": "1" },
  { "wait": 1 },
  { "click": "Save", "selector": "form[action$='/monitor'] button" },
  { "wait": 2 },
  { "scrollTo": "Monitoring", "selector": "h2", "block": "center", "hold": 1 },
  { "click": "Check now" },
  { "mark": "monitor-run", "caption": "Checking now (sped up)", "speed": 8 },
  { "until": "Last check", "max": 600, "hold": 1 },
  { "mark": "monitor-done", "caption": "Watching: the next change to the model or Linden's systems runs the tests again", "speed": 1 },
  { "scrollTo": "Monitoring", "selector": "h2", "block": "center", "hold": 4 },
  { "mark": "hours", "caption": "Engineers log hours and tag what needed a person", "speed": 1 },
  { "scrollTo": "Log engineer hours", "selector": "h2", "block": "center", "hold": 1 },
  { "fill": "input[name=hours]", "value": "6" },
  { "fill": "input[name=tag]", "value": "client API has no docs" },
  { "click": "Log hours" },
  { "wait": 2 },

  { "go": "/__CLIENTS__" },
  { "mark": "next-client", "caption": "The next client: Brightdesk opens a second store", "speed": 1 },
  { "wait": 2 },
  { "click": "Add a sample client" },
  { "wait": 2 },
  { "click": "Run the rollout" },
  { "mark": "second-rollout", "caption": "This rollout starts from the playbook (sped up)", "speed": 10 },
  { "until": "Run the rollout again", "max": 900 },
  { "mark": "reuse", "caption": "Test messages from the first client are proposed for review, and the integration starts from its shape", "speed": 1 },
  { "scrollTo": "Add test messages from your playbook", "selector": "p", "block": "center", "hold": 6 },

  { "go": "/__CLIENTS__" },
  { "mark": "clients", "caption": "Back at Brightdesk: every client's status in one place", "speed": 1 },
  { "wait": 4 },
  { "click": "Productization health", "selector": "a" },
  { "mark": "health", "caption": "Productization health: is each rollout more software and less services?", "speed": 1 },
  { "wait": 3 },
  { "scrollBy": 500, "hold": 4 },
  { "scrollBy": 500, "hold": 3 }
]
