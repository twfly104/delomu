  {
    "mark": "drafting",
    "caption": "Drafting from the client's policy, past tickets and test account (sped up)",
    "speed": 6
  },
  {
    "until": "Run the policy check\\s+Running|Run the rollout again",
    "max": 420
  },
  {
    "go": "/__SCAN__"
  },
  {
    "mark": "check",
    "caption": "Every test message goes to the client's agent; each tile is one answer and what the agent did",
