  },
  {
    "until": "policy rules broken|rules kept",
    "after": "Judging",
    "max": 400,
    "hold": 2
  },
  {
    "mark": "results",
    "caption": "The agent cancelled an order placed 3 hours ago. The policy allows 1 hour",
    "speed": 1
  },
  {
    "scrollTo": "Broken rules",
    "hold": 2.5
  },
  {
    "scrollBy": 260,
    "hold": 3
  },
  {
    "scrollBy": 260,
    "hold": 3
  },
  {
    "scrollTo": "Fix it",
    "block": "center",
    "hold": 1.5
  },
  {
    "mark": "fix",
    "caption": "The agent drafts one fix to the instructions; a person approves it",
    "speed": 2
  },
  {
    "click": "Draft a fix"
  },
  {
    "until": "Proposed fix",
    "max": 120,
    "hold": 1
  },
  {
    "scrollTo": "Proposed fix",
    "block": "start",
    "hold": 3
  },
  {
    "click": "Approve, apply and re-check"
  },
  {
    "mark": "recheck",
    "caption": "The same messages run again on the fixed agent (sped up)",
    "speed": 4
  },
  {
    "until": "After the fix",
    "after": "Judging",
    "max": 400,
    "hold": 2
  },
  {
    "mark": "after",
    "caption": "Before and after, on the same messages",
    "speed": 1
  },
  {
    "wait": 4
  },
  {
    "go": "/__ROLLOUT__"
  },
  {
    "mark": "signoff",
