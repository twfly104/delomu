  },
  {
    "check": "input[name=kind][value=vendor]"
  },
  {
    "wait": 0.8
  },
  {
    "click": "Create free account"
  },
  {
    "click": "I saved it, continue"
  },
  {
    "mark": "client",
    "caption": "One workspace per client. Open the sample client: Linden & Co., an online store",
    "speed": 1
  },
  {
    "wait": 1.5
  },
  {
    "click": "Open a sample client"
  },
  {
    "mark": "rollout",
    "caption": "One click: the agent drafts the mapping, integration and test set, then the check runs",
